{
  "cli": {
    "version": ">= 21.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "OPENCODE_IOS_BUNDLE_ID": "dev.opencode.mobile"
      }
    },
    "production": {
      "distribution": "store",
      "ios": {
        "autoIncrement": "buildNumber"
      },
      "env": {
        "OPENCODE_IOS_BUNDLE_ID": "dev.opencode.mobile"
      }
    }
  }
}
